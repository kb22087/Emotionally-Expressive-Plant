// ============================================================
// DHT ERROR SCREEN
// ============================================================

void drawDHTError()
{
  u8g2.firstPage();

  do
  {
    u8g2.setFont(u8g2_font_6x10_tf);

    u8g2.drawStr(
      22,
      25,
      "DHT11 ERROR"
    );

    u8g2.drawStr(
      8,
      43,
      "Check connection"
    );

  } while (u8g2.nextPage());
}
